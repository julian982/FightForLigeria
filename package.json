{
  "name": "fightforligeria",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "client",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev -w client",
    "build": "npm run build -w client",
    "build:single": "npm run build:single -w client",
    "preview": "npm run preview -w client",
    "test": "vitest run",
    "typecheck": "tsc -p shared && tsc -p client && tsc -p server",
    "dev:server": "npm run dev -w server",
    "build:server": "npm run build -w server",
    "test:server": "npm run test -w server"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "4.0.18",
    "@types/three": "0.128.0",
    "vite": "8.3.4",
    "vite-plugin-singlefile": "2.3.3",
    "esbuild": "0.28.2",
    "@types/node": "22.20.5"
  },
  "dependencies": {
    "three": "0.128.0",
    "@colyseus/core": "0.18.18",
    "@colyseus/ws-transport": "0.18.4",
    "@colyseus/sdk": "0.18.5"
  }
}