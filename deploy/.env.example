# Réglages du serveur de jeu sur le VPS. Copie ce fichier en /opt/fightforligeria/.env, remplis-le, puis :
#   chmod 600 .env && docker compose up -d
# Ne le mets jamais dans le dépôt.

# ---- base de données (le conteneur « db » du même projet) ----
DB_HOST=db
DB_PORT=3306
DB_NAME=ffl
DB_USER=ffl
# mot de passe long et aléatoire, par exemple : openssl rand -base64 32 | tr -d '/+='
DB_PASSWORD=

# ---- adresses utilisées dans les emails ----
# la page du jeu (où arrivent les liens de confirmation et de nouveau mot de passe)
GAME_URL=https://julian982.github.io/FightForLigeria/
# l'adresse publique du serveur de jeu (le lien de confirmation passe par lui)
API_PUBLIC_URL=https://fightforligeria.trouve-ton-serveur.fr

# ---- confirmation de l'adresse email à l'inscription ----
# vide : on s'inscrit et on joue tout de suite (en attendant le SMTP). 1 : il faut cliquer le lien reçu avant de se connecter.
EMAIL_VERIFY=

# ---- envoi des emails (SMTP) ----
# sans SMTP_HOST, aucun email n'est envoyé : ils sont seulement écrits dans les journaux (docker compose logs game)
SMTP_HOST=
# 587 (STARTTLS) ou 465 (TLS)
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=FightForLigeria <noreply@trouve-ton-serveur.fr>
